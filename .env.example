# ─── Twilio Credentials ───
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Render Webhook URL (get this after deploying server.py to Render)
RENDER_WEBHOOK_URL=https://your-app-name.onrender.com

# ─── Schedule Source ───
# "excel"  = local .xlsx file. No setup needed — recommended for testing.
# "google" = live Google Sheet. Needs a Google Cloud service account (see
#            README > Option B); required for the cloud/cron setup.
SHEET_BACKEND=excel

# ─── Excel source (used when SHEET_BACKEND=excel) ───
EXCEL_FILE_PATH=Sample_Driver_Pickup_Schedule V2.xlsx

# ─── Google Sheet source (used when SHEET_BACKEND=google) ───
# Leave GOOGLE_WORKSHEET_NAME blank to use the first worksheet.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=

# ─── Agent Settings ───
CHECK_INTERVAL_SECONDS=60
REMINDER_MINUTES_BEFORE=30
