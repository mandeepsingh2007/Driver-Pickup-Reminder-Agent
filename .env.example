# ─── Twilio Credentials ───
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Render Webhook URL (get this after deploying server.py to Render)
RENDER_WEBHOOK_URL=https://your-app-name.onrender.com

# ─── Google Sheet ───
# 1. Create a Google Cloud service account; download its JSON key as
#    service_account.json in this folder (path below).
# 2. Share your Google Sheet with the service account email as Editor.
# 3. Put the sheet ID (the long id in the sheet URL) below.
# Leave GOOGLE_WORKSHEET_NAME blank to use the first worksheet.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=

# ─── Agent Settings ───
CHECK_INTERVAL_SECONDS=60
REMINDER_MINUTES_BEFORE=30
