# ─── Twilio Credentials ───
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Render Webhook URL (get this after deploying server.py to Render)
RENDER_WEBHOOK_URL=https://your-app-name.onrender.com

# ─── Schedule Source ───
# "auto"   = watch whichever sources are set up (default). Edit the Excel file
#            or the Google Sheet - the agent picks up either, no change here.
# "excel"  = local .xlsx file only.
# "google" = live Google Sheet only; required for the cloud/cron setup.
SHEET_BACKEND=auto

# ─── Excel source (used when SHEET_BACKEND is excel or auto) ───
EXCEL_FILE_PATH=Sample_Driver_Pickup_Schedule V2.xlsx

# ─── Google Sheet source (used when SHEET_BACKEND is google or auto) ───
# Leave GOOGLE_WORKSHEET_NAME blank to use the first worksheet.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=

# ─── Agent Settings ───
CHECK_INTERVAL_SECONDS=60
REMINDER_MINUTES_BEFORE=30
